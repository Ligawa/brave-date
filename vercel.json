{
  "version": 2,
  "buildCommand": "REACT_APP_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL REACT_APP_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY npm run build",
  "builds": [{ "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } }, { "src": "api/index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
